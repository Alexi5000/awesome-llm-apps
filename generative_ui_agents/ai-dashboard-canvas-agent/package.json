{
  "name": "adk-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:agent": "./scripts/run-agent.sh || scripts/run-agent.bat",
    "dev:ui": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "install:agent": "./scripts/setup-agent.sh || scripts\\setup-agent.bat",
    "postinstall": "npm run install:agent",
    "test:collection-limits": "node --test tests/zod-collection-limits.test.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.3",
    "@ai-sdk/openai": "^2.0.136",
    "@copilotkit/react-core": "^1.80.0",
    "@copilotkit/react-textarea": "^1.80.0",
    "@copilotkit/react-ui": "^1.80.0",
    "@copilotkit/runtime": "^1.80.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flowtoken": "^1.0.40",
    "geist": "^1.8.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy@^3": "^3.2.2",
      "uuid@>=9 <11": "^11.1.1",
      "katex": "^0.18.2",
      "@a2ui/web_core": "^0.10.2",
      "undici@>=5 <7": "^6.29.1",
      "postcss-selector-parser": "^7.1.6",
      "prismjs": "^1.30.0",
      "postcss": "^8.5.23",
      "@ag-ui/client": "1.0.3",
      "@ag-ui/core": "1.0.3",
      "@ag-ui/encoder": "1.0.3"
    },
    "patchedDependencies": {
      "zod@3.25.76": "patches/zod@3.25.76.patch",
      "zod@4.6.7": "patches/zod@4.6.7.patch"
    }
  },
  "packageManager": "pnpm@10.13.1"
}
