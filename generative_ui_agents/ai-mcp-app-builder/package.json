      "uuid@>=9 <11": "^11.1.1",
      "katex": "^0.18.2",
      "@a2ui/web_core": "^0.10.2",
      "undici@>=5 <7": "^6.29.1",
      "postcss-selector-parser": "^7.1.6",
      "prismjs": "^1.30.0",
      "postcss": "^8.5.23",
      "hono": "^4.13.11",
      "@hono/node-server@^1": "^1.19.15",
      "@modelcontextprotocol/sdk@^1": "^1.32.2",
