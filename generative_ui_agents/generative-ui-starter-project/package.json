{
  "name": "copilotkit-langgraph-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:ui": "next dev --turbopack",
    "dev:agent": "./scripts/run-agent.sh || scripts\\run-agent.bat",
    "build": "next build",
    "start": "next start",
    "install:agent": "./scripts/setup-agent.sh || scripts\\setup-agent.bat",
    "postinstall": "npm run patch:zod && npm run install:agent",
    "patch:zod": "node scripts/patch-zod.cjs",
    "test:collection-limits": "node --test tests/zod-collection-limits.test.mjs tests/zod-patch-applicator.test.mjs",
    "prebuild": "npm run patch:zod",
    "prestart": "npm run patch:zod",
    "predev": "npm run patch:zod",
    "predev:ui": "npm run patch:zod",
    "predev:debug": "npm run patch:zod"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "^1.80.0",
    "@copilotkit/react-core": "^1.80.0",
    "@copilotkit/react-ui": "^1.80.0",
    "@copilotkit/runtime": "^1.80.0",
    "@copilotkit/shared": "^1.80.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "next": "^16.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-rnd": "^10.5.2",
    "react18-json-view": "^0.2.9",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7",
    "@ag-ui/client": "1.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@fastify/busboy@^3": "^3.2.2",
    "uuid@>=9 <11": "^11.1.1",
    "katex": "^0.18.2",
    "@a2ui/web_core": "^0.10.2",
    "undici@>=5 <7": "^6.29.1",
    "postcss-selector-parser": "^7.1.6"
  }
}
