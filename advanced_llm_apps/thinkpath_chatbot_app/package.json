{
  "name": "guided-llm-chat",
  "version": "1.0.0",
  "description": "Local LLM chat with guided responses",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run start\" \"npm run watch\"",
    "watch": "nodemon --exec npm run start",
    "build": "node scripts/verify-braces.cjs && electron-builder",
    "test:security": "node scripts/verify-braces.cjs",
    "test:runtime": "electron tests/runtime-smoke.cjs"
  },
  "devDependencies": {
    "braces": "file:vendor/braces-3.0.3.tgz",
    "concurrently": "^8.2.0",
    "electron": "44.9.0",
    "nodemon": "^3.0.0"
  },
  "overrides": { "braces": "$braces" },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
